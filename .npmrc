# nodemailer 10.x is required to clear the high-severity advisory, but
# next-auth@5.0.0-beta declares peerOptional "nodemailer@^7.0.7 || ^8.0.5".
# That peer only applies to next-auth's Email provider, which this app does not
# use (auth.ts configures the Credentials provider only), and lib/email.ts uses
# just the core createTransport/sendMail API that is unchanged since v7.
legacy-peer-deps=true