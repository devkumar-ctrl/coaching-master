# ===== Frontend (Netlify / localhost:3000) =====
# Copy to .env.local for development, or set these in Netlify.
# NEXT_PUBLIC_* variables are INLINED INTO THE CLIENT BUNDLE AT BUILD TIME.
# Changing one requires a rebuild/redeploy — setting it at runtime has no effect.

# Backend API base URL — the target of the /api/* rewrite in next.config.ts.
# Local dev: backend on :4000 -> http://localhost:4000
# Production: your Vercel backend, e.g. https://yuvabot-api.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000