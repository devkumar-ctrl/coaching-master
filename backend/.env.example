# ===== Backend (Vercel / localhost:4000) =====
# Copy to .env.local for development, or set these in the Vercel dashboard.
# NOTE: names are AUTH_SECRET / AUTH_URL (NextAuth v5), not NEXTAUTH_*.

# MongoDB — REQUIRED at runtime. The connection is created lazily, so it is NOT
# needed for `npm run build`, only when requests actually hit the database.
MONGODB_URI=mongodb://localhost:27017/coaching

# NextAuth v5
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public site origin (the Netlify frontend). Auth.js builds redirects
# (signin, signout, callback, callback-url cookie) against this URL, so it must
# be the FRONTEND origin — not the Vercel backend origin.
AUTH_URL=http://localhost:3000

# Payments (Razorpay) — optional. Without these, /api/payments returns 503.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary — required for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer / SMTP) — used for OTP login, enrollment & notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# For Gmail, EMAIL_PASSWORD must be a 16-char App Password, not the account password.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="YuvaBot Lab" <your-sender-email>

# Zoom (optional alternative meeting provider)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SECRET_TOKEN=

# Meeting providers
JITSI_DOMAIN=meet.jit.si
DAILY_API_KEY=
DAILY_DOMAIN=yuvabot.daily.co

# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000