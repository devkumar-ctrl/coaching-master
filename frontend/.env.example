# ===== Frontend (Netlify / localhost:3000) =====
# Copy to .env.local for development, or set these in Netlify.
# NEXT_PUBLIC_* variables are INLINED INTO THE CLIENT BUNDLE AT BUILD TIME.
# Changing one requires a rebuild/redeploy — setting it at runtime has no effect.

# Backend API base URL — the target of the /api/* rewrite in next.config.ts.
# Local dev: backend on :4000 -> http://localhost:4000
# Production: the Vercel backend, https://coaching-master-psi.vercel.app
# Set in netlify.toml [build.environment]. Required for production builds:
# next.config.ts throws if it is missing so a broken deploy cannot ship.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site URL — must match the backend's AUTH_URL.
# Production: https://superb-toffee-966a8c.netlify.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LMS subdomain — where the student "My Learning" experience is hosted.
# The LMS is a route inside this same app (/lms); middleware.ts rewrites any
# request whose host starts with "lms." or "learn." onto that route, so point
# this subdomain's DNS/CNAME at the same deployment.
# Local dev: http://lms.localhost:3000
NEXT_PUBLIC_LMS_URL=http://lms.localhost:3000